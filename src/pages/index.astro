---
import BaseLayout from '../layouts/BaseLayout.astro';
import { accents, categories, nav, playlist, profile, projects, reasons, services, testimonials, themes, tools } from '../data/siteData';
---

<BaseLayout>
  <div class="liquid-bg" aria-hidden="true">
    <span class="orb orb-a"></span>
    <span class="orb orb-b"></span>
    <span class="orb orb-c"></span>
  </div>

  <header class="header glass">
    <a href="#" class="brand">{profile.brand}</a>
    <nav>
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <button class="btn ghost" data-scroll="#contact">Hire Me</button>
  </header>

  <main>
    <section class="hero section">
      <div class="hero-copy reveal">
        <p class="pill">{profile.badge}</p>
        <h1>{profile.headline}</h1>
        <p>{profile.subheadline}</p>
        <div class="actions">
          <button class="btn" data-scroll="#portfolio">Explore Work</button>
          <button class="btn ghost" data-scroll="#contact">Start Project</button>
        </div>
      </div>
      <div class="hero-panel glass reveal tilt">
        <p class="muted">Current Role</p>
        <h3>{profile.role}</h3>
        <ul>
          <li>Premium quality delivery</li>
          <li>Performance-first engineering</li>
          <li>Custom system architecture</li>
        </ul>
      </div>
    </section>

    <section id="about" class="section reveal">
      <h2>About Me</h2>
      <article class="glass card">
        <p>
          I help communities and studios build modern, scalable ecosystems across Minecraft and Discord. I focus on premium UX,
          robust system design, and polished implementation that feels memorable and professional.
        </p>
      </article>
    </section>

    <section id="services" class="section">
      <h2 class="reveal">What I Build</h2>
      <div class="service-grid">
        {services.map((item) => (
          <article class="glass card reveal tilt">
            <strong>{item.icon} {item.title}</strong>
            <p>{item.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="portfolio" class="section">
      <div class="portfolio-head reveal">
        <h2>Featured Work</h2>
        <div class="chip-row">
          {categories.map((category) => <button class="chip" data-filter={category.id}>{category.label}</button>)}
        </div>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <article class="glass project reveal tilt" data-category={project.category}>
            <img src={project.image} alt={`${project.title} preview`} loading="lazy" width="1200" height="700" />
            <div class="content">
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
              <div class="tags">
                {project.tags.map((tag) => <span>{tag}</span>)}
              </div>
              <div class="actions">
                <a class="btn small" href="#contact">Details</a>
                <a class="btn ghost small" href="#contact">Contact</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section split">
      <article class="glass card reveal">
        <h2>Skills / Tools</h2>
        <div class="tags">
          {tools.map((tool) => <span>{tool}</span>)}
        </div>
      </article>
      <article class="glass card reveal">
        <h2>Why Choose Me</h2>
        <ul>
          {reasons.map((reason) => <li>{reason}</li>)}
        </ul>
      </article>
    </section>

    <section class="section">
      <h2 class="reveal">Testimonials</h2>
      <div class="testimonial-grid">
        {testimonials.map((item) => (
          <blockquote class="glass card reveal">
            <p>“{item.quote}”</p>
            <cite>{item.name}</cite>
          </blockquote>
        ))}
      </div>
    </section>

    <section id="contact" class="section reveal">
      <article class="glass card contact-card">
        <h2>Let’s build your next premium project.</h2>
        <p>For Minecraft, Discord, and custom development work, reach out and let’s map your vision.</p>
        <div class="actions center">
          <a class="btn" href="mailto:hello@yourbrand.dev">Email</a>
          <a class="btn ghost" href="https://discord.com" target="_blank" rel="noreferrer">Discord</a>
        </div>
      </article>
    </section>
  </main>

  <aside class="customizer glass">
    <h3>Customize</h3>
    <small>Theme</small>
    <div class="chip-row">
      {themes.map((theme) => <button class="chip" data-theme={theme.key}>{theme.name}</button>)}
    </div>
    <small>Accent</small>
    <div class="swatches">
      {accents.map((accent) => <button class="swatch" style={`--sw:${accent}`} data-accent={accent} aria-label={`Accent ${accent}`}></button>)}
    </div>
  </aside>

  <aside class="player glass" id="player">
    <button class="toggle" aria-label="Toggle music">♫ Music</button>
    <div class="drawer">
      <small>Now Playing</small>
      <h4 id="track-title">{playlist[0].title}</h4>
      <p id="track-artist">{playlist[0].artist}</p>
      <div class="actions">
        <button id="prev" class="btn small">Prev</button>
        <button id="play" class="btn small">Play</button>
        <button id="next" class="btn small">Next</button>
      </div>
      <label for="vol">Volume</label>
      <input id="vol" type="range" min="0" max="1" step="0.05" value="0.65" />
    </div>
    <audio id="audio" preload="none"></audio>
  </aside>

  <footer class="footer section">
    <p>© {new Date().getFullYear()} {profile.brand}. All rights reserved.</p>
    <a href="#">Back to top ↑</a>
  </footer>

  <script define:vars={{ playlist }}>
    const root = document.documentElement;

    // Section reveal
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add('in'));
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

    // Smooth scroll triggers
    document.querySelectorAll('[data-scroll]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelector(btn.dataset.scroll)?.scrollIntoView({ behavior: 'smooth' });
      });
    });

    // Portfolio filters
    const filterButtons = document.querySelectorAll('[data-filter]');
    const projectCards = document.querySelectorAll('.project');
    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((item) => item.classList.remove('active'));
        btn.classList.add('active');
        const selected = btn.dataset.filter;
        projectCards.forEach((card) => {
          const show = selected === 'all' || card.dataset.category === selected;
          card.style.display = show ? 'grid' : 'none';
        });
      });
    });
    document.querySelector('[data-filter="all"]')?.classList.add('active');

    // Theme + accent
    const THEME_KEY = 'theme-key';
    const ACCENT_KEY = 'accent-key';

    const applyTheme = (theme) => { root.dataset.theme = theme; };
    const applyAccent = (accent) => { root.style.setProperty('--accent', accent); };

    applyTheme(localStorage.getItem(THEME_KEY) || 'dark');
    applyAccent(localStorage.getItem(ACCENT_KEY) || '#7a7cff');

    document.querySelectorAll('[data-theme]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.theme;
        applyTheme(next);
        localStorage.setItem(THEME_KEY, next);
      });
    });

    document.querySelectorAll('[data-accent]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.accent;
        applyAccent(next);
        localStorage.setItem(ACCENT_KEY, next);
      });
    });

    // Subtle mouse glow
    window.addEventListener('pointermove', (event) => {
      root.style.setProperty('--mx', `${event.clientX}px`);
      root.style.setProperty('--my', `${event.clientY}px`);
    }, { passive: true });

    // Card tilt
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reducedMotion) {
      document.querySelectorAll('.tilt').forEach((card) => {
        card.addEventListener('pointermove', (event) => {
          const rect = card.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width - 0.5;
          const y = (event.clientY - rect.top) / rect.height - 0.5;
          card.style.setProperty('--rx', `${-y * 8}deg`);
          card.style.setProperty('--ry', `${x * 9}deg`);
        });
        card.addEventListener('pointerleave', () => {
          card.style.setProperty('--rx', '0deg');
          card.style.setProperty('--ry', '0deg');
        });
      });
    }

    // Music player
    const stateKey = 'music-state';
    const player = document.getElementById('player');
    const drawerToggle = player.querySelector('.toggle');
    const audio = document.getElementById('audio');
    const title = document.getElementById('track-title');
    const artist = document.getElementById('track-artist');
    const play = document.getElementById('play');
    const prev = document.getElementById('prev');
    const next = document.getElementById('next');
    const vol = document.getElementById('vol');

    let state = JSON.parse(localStorage.getItem(stateKey) || '{"index":0,"time":0,"volume":0.65,"open":false}');
    let index = Math.min(state.index || 0, playlist.length - 1);

    const loadTrack = (newIndex, seek = 0) => {
      index = (newIndex + playlist.length) % playlist.length;
      audio.src = playlist[index].src;
      audio.currentTime = seek;
      title.textContent = playlist[index].title;
      artist.textContent = playlist[index].artist;
    };

    loadTrack(index, state.time || 0);
    audio.volume = state.volume ?? 0.65;
    vol.value = String(audio.volume);
    player.classList.toggle('open', Boolean(state.open));

    drawerToggle.addEventListener('click', () => {
      player.classList.toggle('open');
      state.open = player.classList.contains('open');
      localStorage.setItem(stateKey, JSON.stringify({ ...state, index, time: audio.currentTime, volume: audio.volume }));
    });

    play.addEventListener('click', async () => {
      if (audio.paused) {
        try {
          await audio.play();
          play.textContent = 'Pause';
        } catch {
          play.textContent = 'Tap to enable';
        }
      } else {
        audio.pause();
        play.textContent = 'Play';
      }
    });

    next.addEventListener('click', () => loadTrack(index + 1));
    prev.addEventListener('click', () => loadTrack(index - 1));
    audio.addEventListener('ended', () => {
      loadTrack(index + 1);
      audio.play().catch(() => {});
    });
    vol.addEventListener('input', () => {
      audio.volume = Number(vol.value);
    });

    setInterval(() => {
      localStorage.setItem(stateKey, JSON.stringify({
        index,
        time: audio.currentTime || 0,
        volume: audio.volume,
        open: player.classList.contains('open'),
      }));
    }, 1000);
  </script>
</BaseLayout>
